[Unit]
Description=Yantra nightly dream consolidation (loop-protocol §2.5)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
Environment=YANTRA_HOME=/opt/yantra
Environment=YANTRA_ENV_FILE=/opt/yantra/env/yantra.env
ExecStart=/opt/yantra/repo/ops/yantra/dream-nightly.sh
TimeoutStartSec=45min
User=root
