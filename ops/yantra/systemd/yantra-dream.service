[Unit]
Description=Yantra nightly dream consolidation (containerized, loop-protocol §2.5)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
# D21: containerized like the tick; spawns its own claude run-container as a
# sibling via the mounted docker socket.
ExecStartPre=-/usr/bin/git -C /opt/yantra/repo pull --ff-only
ExecStart=/usr/bin/docker run --rm --name yantra-dream \
	--memory=1g --cpus=1 \
	-v /var/run/docker.sock:/var/run/docker.sock \
	-v /opt/yantra/repo:/opt/yantra/repo:ro \
	-v /opt/yantra/telemetry:/opt/yantra/telemetry \
	-v /opt/yantra/env:/opt/yantra/env:ro \
	yantra-exec:0 /opt/yantra/repo/ops/yantra/dream-nightly.sh
ExecStopPost=-/usr/bin/docker rm -f yantra-dream
TimeoutStartSec=45min
User=root
