[Unit]
Description=Yantra loop v0 — one tick (claim/advise/execute/grade/dream)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
Environment=YANTRA_HOME=/opt/yantra
Environment=YANTRA_ENV_FILE=/opt/yantra/env/yantra.env
ExecStart=/opt/yantra/repo/ops/yantra/loop-tick.sh
# The tick exits 0 by contract; a hung tick is killed before the next timer fire.
TimeoutStartSec=9min
User=root
